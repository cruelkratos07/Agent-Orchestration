# Copy to .env and edit. NOTHING here is required - with all of it unset the
# project runs on SQLite, an in-process cache, and deterministic keyword
# routing, and every demo still works.
#
# .env is gitignored. Never commit a real key.

# ---- web access ----
# Enable only for the isolated synthetic-data demo. In authenticated mode,
# provision records with scripts/create_access.py and supply the JSON array.
# DEMO_MODE=false
# SUPPORT_CREDENTIALS=[]

# ---- model provider: install one package, set one key ----
# pip install langchain-google-genai      https://aistudio.google.com/apikey
GEMINI_API_KEY=
# pip install langchain-groq              https://console.groq.com/keys
# GROQ_API_KEY=
# pip install langchain-anthropic         https://console.anthropic.com
# ANTHROPIC_API_KEY=

# Pin a provider explicitly, or leave blank to auto-detect from whichever key
# is set. Use "none" to force deterministic mode even with a key present.
# LLM_PROVIDER=
# Override the model name if the default has been retired.
# LLM_MODEL=

# ---- optional services (docker compose up -d) ----
# Matches the credentials in docker-compose.yml.
# DATABASE_URL=postgresql://orderagent:localdev@localhost:5432/support
# REDIS_URL=redis://localhost:6379
# CACHE_TTL_SECONDS=3600
